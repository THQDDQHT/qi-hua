# Copy to .env.public. Do not commit the completed file.
# All public traffic must enter through the Cloudflare-proxied HTTPS origin below.
PUBLIC_WEB_PORT=443
PUBLIC_TLS_CERT_PATH=/absolute/path/to/cloudflare-origin.crt
PUBLIC_TLS_KEY_PATH=/absolute/path/to/cloudflare-origin.key
PUBLIC_ORIGIN=https://canvas.example.com

# Existing PostgreSQL only. Use a production-specific least-privilege account.
DATABASE_URL=postgres://infinite_canvas_public:replace-me@postgres.internal:5432/infinite_canvas

# Upstream values remain server-only and must never be included in the web image.
AI_BASE_URL=https://provider.example.com/v1
AI_API_KEY=replace-me
AI_MODEL=replace-me

# Generate independent values of at least 32 characters.
ANON_TOKEN_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-at-least-32-random-characters
IDEMPOTENCY_SECRET=replace-with-at-least-32-random-characters

TIMEZONE=Asia/Shanghai
PUBLIC_GENERATION_ENABLED=false
DAILY_DEVICE_LIMIT=10
DAILY_IP_LIMIT=30
UPSTREAM_TIMEOUT_MS=180000
RESERVATION_TTL_SECONDS=600
