# Copy to .env.public. Do not commit the completed file.
# Cloudflare provides public HTTPS and reaches this host through a local HTTP Tunnel route.
PUBLIC_WEB_BIND_IP=127.0.0.1
PUBLIC_WEB_PORT=7777
PUBLIC_WEB_HOST=canvas.example.com
PUBLIC_ORIGIN=https://canvas.example.com

# Existing PostgreSQL and Redis share this external network; the web container does not join it.
DATABASE_DOCKER_NETWORK=app_shared_net
DATABASE_URL=postgres://infinite_canvas_public:replace-me@postgres:5432/infinite_canvas

# Separate Redis business credentials file containing REDIS_URL and REDIS_PREFIX.
REDIS_ENV_FILE=/absolute/path/to/redis/infinite-canvas.env

# Upstream values remain API/worker-only and must never be included in the web image.
AI_BASE_URL=https://provider.example.com/v1
AI_API_KEY=replace-me
AI_MODEL=replace-me

# Generate independent values of at least 32 characters.
ANON_TOKEN_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-at-least-32-random-characters
IDEMPOTENCY_SECRET=replace-with-at-least-32-random-characters

TIMEZONE=Asia/Shanghai
PUBLIC_GENERATION_ENABLED=false
DAILY_DEVICE_LIMIT=10
DAILY_IP_LIMIT=30
UPSTREAM_TIMEOUT_MS=180000
RESERVATION_TTL_SECONDS=21600
EXECUTION_LEASE_SECONDS=300
IMAGE_WORKER_CONCURRENCY=5
GENERATION_STORAGE_DIR=/data/public-generation-temp
GENERATION_RESULT_TTL_SECONDS=86400
WORKER_HEALTH_PORT=3002
